---
const skillCategories = [
  {
    title: "Redes & Infraestrutura",
    icon: `<svg class="w-4 h-4 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" /></svg>`,
    skills: ["VLANs", "Switching & Routing", "Cisco / Aruba", "SSH", "Tailscale (Mesh VPN)", "Pi-hole (DNS)"]
  },
  {
    title: "Sistemas & DevOps",
    icon: `<svg class="w-4 h-4 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>`,
    skills: ["Linux (Ubuntu, Pop!_OS)", "Docker", "Portainer", "Nextcloud", "Vaultwarden", "Monitorização UPS"]
  },
  {
    title: "Desenvolvimento & Dados",
    icon: `<svg class="w-4 h-4 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`,
    skills: ["Dart", "Flutter", "C++", "SQL", "Bash Scripting", "Git"]
  }
];
---

<section id="skills" class="py-16 scroll-mt-16">
  <div class="flex items-center gap-3 mb-8">
    <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
      Competências Técnicas
    </h2>
    <div class="h-px flex-1 bg-zinc-200 dark:bg-zinc-800"></div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {skillCategories.map((category) => (
      <div class="p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white/50 dark:bg-zinc-900/40">
        <div class="flex items-center gap-2.5 mb-4">
          <Fragment set:html={category.icon} />
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 text-sm">
            {category.title}
          </h3>
        </div>
        <ul class="space-y-2.5">
          {category.skills.map((skill) => (
            <li class="flex items-center gap-2 text-sm text-zinc-600 dark:text-zinc-400 font-mono">
              <span class="w-1 h-1 rounded-full bg-zinc-400 dark:bg-zinc-600"></span>
              {skill}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>