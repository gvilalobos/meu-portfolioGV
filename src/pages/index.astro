---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';
import Footer from '../components/Footer.astro';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Gabriel Vilalobos | Redes, Sistemas & Software">
  <Navbar />
  
  <main class="max-w-4xl mx-auto px-6 w-full flex-1">
    <Hero />

    <section id="projetos" class="py-16 scroll-mt-16">
      <div class="flex items-center gap-3 mb-8">
        <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
          Projetos em Destaque
        </h2>
        <div class="h-px flex-1 bg-zinc-200 dark:bg-zinc-800"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>

    <Skills />
    <Experience />
  </main>

  <Footer />
</Layout>